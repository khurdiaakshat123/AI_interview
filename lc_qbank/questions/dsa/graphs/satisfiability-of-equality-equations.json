  "slug": "satisfiability-of-equality-equations",
  "title": "Satisfiability of Equality Equations",
  "category": "dsa",
  "subcategory": "graphs",
  "difficulty": "Medium",
  "tags": [
    "Array",
    "String",
    "Union-Find",
    "Graph Theory"
