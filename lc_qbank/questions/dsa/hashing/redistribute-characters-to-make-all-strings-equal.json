  "slug": "redistribute-characters-to-make-all-strings-equal",
  "title": "Redistribute Characters to Make All Strings Equal",
  "category": "dsa",
  "subcategory": "hashing",
  "difficulty": "Easy",
  "tags": [
    "Hash Table",
    "String",
